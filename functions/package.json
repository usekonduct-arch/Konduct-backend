{
  "name": "konduct-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test \"lib/**/*.test.js\"",
    "test:emulator": "tsc && firebase emulators:exec --project demo-konduct --only firestore,auth \"node --test --test-concurrency=1 \\\"lib/**/*.emu.js\\\"\"",
    "bootstrap-admin": "tsc && node lib/scripts/bootstrap-admin.js"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.20.5",
    "firebase": "^12.19.0",
    "typescript": "~5.9"
  }
}
