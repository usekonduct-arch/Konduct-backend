rules_version = '2';

// Default deny (SEC-AUTH-02). The server is the only writer of money, roles, identity and trips
// (SRS 3.2). Clients may read only their own records (SEC-AUTH-05, no BOLA), and the one write a
// client can make is marking its own notification as read.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    // Staff console reads: staff claim, completed MFA, a reading role, and a live profile that is
    // active and holds that same role (claims can lag; the profile can't).
    function staffReader() {
      let profile = get(/databases/$(database)/documents/users/$(me())).data;
      return signedIn()
        && request.auth.token.staff == true
        && request.auth.token.firebase.sign_in_second_factor != null
        && request.auth.token.role in ['admin', 'ops', 'support', 'auditor']
        && profile.status == 'active'
        && profile.role == request.auth.token.role;
    }

    function auditor() {
      return staffReader() && request.auth.token.role in ['admin', 'auditor'];
    }

    match /users/{uid} {
      allow read: if (signedIn() && me() == uid) || staffReader();

      match /notifications/{id} {
        allow read: if signedIn() && me() == uid;
        allow update: if signedIn() && me() == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read is bool;
      }
    }

    // A rider or driver: the role claim the backend sets.
    function member() {
      return signedIn() && request.auth.token.role in ['rider', 'driver'];
    }

    // Staff messages to a whole group. Apps read the live ones for their own group.
    match /broadcasts/{id} {
      allow read: if (member() && resource.data.active == true && resource.data.audience in ['all', request.auth.token.role]) || staffReader();
    }

    // Carousel and popup ads, the same way.
    match /ads/{id} {
      allow read: if (member() && resource.data.active == true && resource.data.audience in ['all', request.auth.token.role]) || staffReader();
    }

    // A month's Wrapped sponsor (domain/sponsors.ts): the apps show its logo on that month's Wrapped.
    match /wrappedSponsors/{month} {
      allow read: if (member() && resource.data.active == true && resource.data.audience in ['all', request.auth.token.role]) || staffReader();
    }

    // Sponsors, their ride offers and every ad number: staff only. Members never read these;
    // sponsored rides reach them through payPreview and their own transactions.
    match /sponsors/{id} {
      allow read: if staffReader();
    }
    match /rideCampaigns/{id} {
      allow read: if staffReader();
    }
    match /campaignDays/{id} {
      allow read: if staffReader();
    }
    match /adStats/{id} {
      allow read: if staffReader();
    }
    match /adStatsDays/{id} {
      allow read: if staffReader();
    }

    // Ad and notification images are served by the backend (GET /media/<id>), never read here.
    match /media/{id} {
      allow read: if false;
    }

    // Balances: your own wallet only. Decided by the document id, not its contents, so the app's
    // live balance listener is allowed even before the wallet exists and never gets cut off.
    match /wallets/{accountId} {
      allow read: if (signedIn() && (accountId == 'rider_' + me() || accountId == 'driver_' + me())) || staffReader();
    }

    // Rider receipts (they include the offline code, so the payer only).
    match /transactions/{txId} {
      allow read: if (signedIn() && resource.data.payerUid == me()) || staffReader();
    }

    match /trips/{tripId} {
      allow read: if (signedIn() && resource.data.riderUid == me()) || staffReader();
    }

    // The driver's live payment alerts (FR-PAY-05).
    match /driverFeed/{driverUid}/items/{txId} {
      allow read: if signedIn() && me() == driverUid;
    }

    match /topups/{id} {
      allow read: if signedIn() && resource.data.uid == me();
    }

    match /payouts/{id} {
      allow read: if (signedIn() && resource.data.uid == me()) || staffReader();
    }

    match /payoutAccounts/{id} {
      allow read: if (signedIn() && resource.data.uid == me()) || staffReader();
    }

    match /disputes/{id} {
      allow read: if (signedIn() && resource.data.payerUid == me()) || staffReader();
    }

    match /vehicles/{vehicleId} {
      allow read: if (signedIn() && resource.data.driverUid == me()) || staffReader();
    }

    match /routes/{routeId} {
      allow read: if signedIn();
      match /fares/{version} {
        allow read: if staffReader();
      }
    }

    // So the apps can say "payments are paused" before anyone scans.
    match /config/switches {
      allow read: if signedIn();
    }

    // Seats per bus, for the driver's "3 of 7 seats paid" (domain/seats.ts).
    match /config/fleet {
      allow read: if signedIn();
    }

    // A driver's own daily figures (domain/stats.ts); staff read all of them.
    match /driverDays/{id} {
      allow read: if (signedIn() && resource.data.uid == me()) || staffReader();
    }

    // Konduct's social handles for share captions (domain/brand.ts).
    match /config/brand {
      allow read: if signedIn();
    }

    // Oldest app build still allowed and the latest one (domain/appversion.ts). Public: the apps
    // check it before anyone signs in, and it holds nothing private.
    match /config/app {
      allow read: if true;
    }

    // Referral rewards on/off and amounts, for the invite card (domain/referrals.ts).
    match /config/referrals {
      allow read: if signedIn();
    }

    // "Tell me when a bus is here" (domain/alerts.ts): a rider sees their own; the server writes them.
    match /parkWatches/{id} {
      allow read: if signedIn() && resource.data.uid == me();
    }

    // Parks and how many buses staff last counted there (domain/parks.ts).
    match /parks/{parkId} {
      allow read: if signedIn();
    }

    // The live bus board: a public copy of each active bus (no driver ids or sticker codes) with its
    // park, trip route and seats paid by scan (domain/board.ts). Written by the server only.
    match /liveBuses/{vehicleId} {
      allow read: if signedIn();
    }

    // Places drivers pick a trip route between (domain/landmarks.ts).
    match /landmarks/{landmarkId} {
      allow read: if signedIn();
    }

    // Support chat (domain/support.ts). Members read their own conversations and may only mark
    // them read; staff read everything. Messages are written by the server.
    match /supportThreads/{threadId} {
      allow read: if (signedIn() && resource.data.uid == me()) || staffReader();
      allow update: if signedIn() && resource.data.uid == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberReadAtMs'])
        && request.resource.data.memberReadAtMs is int;
      match /messages/{messageId} {
        allow read: if (signedIn() && get(/databases/$(database)/documents/supportThreads/$(threadId)).data.uid == me()) || staffReader();
      }
    }

    // Riders' ratings and comments: staff only. Drivers see their average on users/{uid}, and recent
    // stars and comments without who left them through driverRatingFeedback.
    match /ratings/{txId} {
      allow read: if staffReader();
    }

    // Operations queues: staff only.
    match /deposits/{id} { allow read: if staffReader(); }
    match /flags/{id} { allow read: if staffReader(); }
    match /approvals/{id} { allow read: if staffReader(); }
    match /reconReports/{id} { allow read: if staffReader(); }
    match /alerts/{id} { allow read: if staffReader(); }
    match /driverInvites/{id} { allow read: if staffReader(); }

    // Books and evidence: admin and finance auditor only (FR-ADM-06).
    match /ledgerEntries/{id} { allow read: if auditor(); }
    match /ledgerTx/{id} { allow read: if auditor(); }
    match /auditLogs/{id} { allow read: if auditor(); }
    match /webhookEvents/{id} { allow read: if auditor(); }

    // Landing-page pilot sign-ups (konduct-landing/src/lib/waitlist.ts). Anyone may add one
    // well-formed entry; nobody can read, edit or delete entries from a browser.
    match /waitlist/{id} {
      allow read: if staffReader();
      allow create: if request.resource.data.keys().hasOnly(['role', 'name', 'contact', 'source', 'createdAt'])
        && request.resource.data.keys().hasAll(['role', 'name', 'contact', 'source', 'createdAt'])
        && request.resource.data.role in ['student', 'driver', 'park']
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.contact is string
        && request.resource.data.contact.size() >= 5 && request.resource.data.contact.size() <= 120
        && request.resource.data.source == 'landing'
        && request.resource.data.createdAt == request.time;
    }

    // The website's blog and careers (konduct-backend/functions/src/domain/site.ts writes them).
    // Anyone may read a published post or a public job; drafts are for staff who edit the site.
    function siteEditor() {
      return staffReader() && request.auth.token.role in ['admin', 'ops'];
    }
    match /posts/{id} {
      allow read: if resource.data.status == 'published' || siteEditor();
    }
    match /jobs/{id} {
      allow read: if resource.data.status in ['open', 'closed'] || siteEditor();
    }

    // Job applications from the careers page (konduct-landing/src/lib/cms.ts). Anyone may send one
    // well-formed application for an open role; only admin and ops can read them.
    match /applications/{id} {
      allow read: if siteEditor();
      allow create: if request.resource.data.keys().hasOnly(['jobId', 'jobTitle', 'name', 'email', 'phone', 'link', 'note', 'consent', 'status', 'source', 'createdAt'])
        && request.resource.data.keys().hasAll(['jobId', 'jobTitle', 'name', 'email', 'phone', 'link', 'note', 'consent', 'status', 'source', 'createdAt'])
        && request.resource.data.jobId is string
        && request.resource.data.jobId.matches('^[A-Za-z0-9_-]{6,40}$')
        && get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.status == 'open'
        && request.resource.data.jobTitle is string && request.resource.data.jobTitle.size() <= 100
        && request.resource.data.name is string && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 80
        && request.resource.data.email is string && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$') && request.resource.data.email.size() <= 120
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30
        && request.resource.data.link is string && request.resource.data.link.matches('^https://.+') && request.resource.data.link.size() <= 500
        && request.resource.data.note is string && request.resource.data.note.size() <= 3000
        && request.resource.data.consent == true
        && request.resource.data.status == 'new'
        && request.resource.data.source == 'careers'
        && request.resource.data.createdAt == request.time;
    }

    // Everything else (pins, studentIds, fundingCodes, payerAccounts, payQuotes, idempotency,
    // rateLimits, dailyTotals, connectAccounts, devices, referralCodes, referrals, ...) has no rule and is denied.
  }
}
